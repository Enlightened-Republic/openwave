{
  "name": "xanima-openclaw",
  "version": "0.5.0",
  "description": "Xanima for OpenClaw (formerly openwave): autonomic long-term memory and agent continuity. Injects identity, goals and query-relevant recall (with confidence and relative-time labels) into every turn, and runs the sleep system. Local brains or a shared Xanima brain service.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Enlightened-Republic/xanima-openclaw.git"
  },
  "homepage": "https://github.com/Enlightened-Republic/xanima-openclaw#readme",
  "engines": {
    "node": ">=24.16.0"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "agent-memory",
    "ai-memory",
    "xanima",
    "agent-continuity",
    "fsrs",
    "knowledge-graph",
    "spaced-repetition"
  ],
  "files": [
    "dist/index.js",
    "dist/upgrade.js",
    "dist/control-ui",
    "brain-docs",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.control-ui.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.0",
      "minGatewayVersion": "2026.5.0"
    },
    "build": {
      "openclawVersion": "2026.9.8",
      "pluginSdkVersion": "2026.9.8"
    }
  },
  "dependencies": {
    "better-sqlite3": "~12.11.1",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "openclaw": "^2026.9.8",
    "typebox": "^1.3.33",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "xanima-core": "file:vendor/xanima-core-0.5.0-2f0be36.tgz"
  },
  "bin": {
    "xanima-openclaw-upgrade": "dist/upgrade.js"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "sqlite-vec": true,
    "esbuild": true
  }
}
