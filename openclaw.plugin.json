{
  "id": "openwave",
  "name": "openwave",
  "version": "0.1.1",
  "description": "Autonomic wake-up memory for OpenClaw agents. Injects identity, goals and query-relevant recall into every turn, and runs the sleep system (consolidation, awake replay, extraction) in-process. Powered by sharpwave-core.",
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "brain_query",
      "brain_write",
      "brain_link",
      "brain_supersede",
      "brain_stats",
      "brain_history",
      "brain_expand",
      "brain_review",
      "brain_forget",
      "brain_edges",
      "brain_reset",
      "brain_update_self_model",
      "brain_reflect",
      "brain_generate_skill",
      "brain_workspace",
      "brain_docs"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agents": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "default": [
          "main"
        ],
        "description": "OpenClaw agent ids openwave serves. Each routes to ~/.sharpwave/<id>/brain.db."
      },
      "contextBudget": {
        "type": "number",
        "default": 2000
      },
      "workingMemorySlots": {
        "type": "number",
        "default": 7
      },
      "spreadingActivationHops": {
        "type": "number",
        "default": 1
      },
      "activationThreshold": {
        "type": "number",
        "default": 0.1
      },
      "inhibitionStrength": {
        "type": "number",
        "default": 0.6
      },
      "recallTopK": {
        "type": "number",
        "default": 10
      },
      "bootstrapTopK": {
        "type": "number",
        "default": 15
      },
      "efDefault": {
        "type": "number",
        "default": 2.5
      },
      "retrievabilityFloor": {
        "type": "number",
        "default": 0.05
      },
      "consolidationTimeGateHours": {
        "type": "number",
        "default": 4
      },
      "consolidationEpisodeGate": {
        "type": "number",
        "default": 10
      },
      "pruneAfterDays": {
        "type": "number",
        "default": 90
      },
      "ingestionModel": {
        "type": "string",
        "default": "openrouter/deepseek/deepseek-v4-flash"
      },
      "remModel": {
        "type": "string"
      },
      "openRouterApiKey": {
        "type": "string",
        "default": ""
      },
      "embeddingModel": {
        "type": "string",
        "default": "ollama/qwen3-embedding:0.6b"
      },
      "llmExtractionEnabled": {
        "type": "boolean",
        "default": false
      },
      "llmExtractionMinImportance": {
        "type": "number",
        "default": 0.4
      },
      "skillEvolution": {
        "type": "boolean",
        "default": false
      },
      "skillEvolveMinPatternCount": {
        "type": "number",
        "default": 5
      },
      "workspaceSkillsDir": {
        "type": "string",
        "default": ""
      },
      "brainDocsDir": {
        "type": "string",
        "default": ""
      },
      "personaOverrides": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "contextBudget": {
              "type": "number"
            },
            "workingMemorySlots": {
              "type": "number"
            },
            "spreadingActivationHops": {
              "type": "number"
            },
            "activationThreshold": {
              "type": "number"
            },
            "inhibitionStrength": {
              "type": "number"
            },
            "efDefault": {
              "type": "number"
            },
            "retrievabilityFloor": {
              "type": "number"
            },
            "consolidationTimeGateHours": {
              "type": "number"
            },
            "consolidationEpisodeGate": {
              "type": "number"
            },
            "pruneAfterDays": {
              "type": "number"
            },
            "emotionalProfile": {
              "type": "object",
              "additionalProperties": false,
              "description": "Reserved for sharpwave-core's valence/arousal split (not yet shipped -- see research/emotional-memory-openclaw-integration.md proposal 3). Accepted and stored but has no runtime effect until sharpwave-core exposes these fields on computeSalience.",
              "properties": {
                "valenceBias": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "arousalScale": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                }
              }
            }
          }
        },
        "default": {},
        "description": "Per-agent-id overrides layered over the flat config above, keyed by OpenClaw agent id (e.g. \"mila\"). Mirrors the agents.entries.<id> override idiom (docs/gateway/config-agents/entries-and-multi-agent.md) applied to openwave's own config. Missing keys inherit the flat value above; emotionalProfile fields are accepted ahead of the engine work that will consume them."
      }
    }
  },
  "controlUi": {
    "entry": "dist/control-ui/c70aba5da3775a85/index.js"
  }
}
